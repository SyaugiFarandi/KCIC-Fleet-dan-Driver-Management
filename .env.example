# Host ports used by docker compose (change if they are already in use)
DB_PORT=5544
API_PORT=4010
WEB_PORT=8090

# API security. WAJIB: generate secret acak minimal 32 karakter, jangan pakai contoh.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Hanya untuk demo HTTP lokal. Biarkan kosong/false untuk deployment HTTPS.
ALLOW_INSECURE_HTTP=true

# Session cookie. Demo HTTP lokal memakai false; deployment HTTPS wajib true.
COOKIE_SECURE=false

# DEMO GPS simulator: generates simulated coordinates for the GPS Monitoring page.
# This is NOT a real GPS device integration. Set GPS_SIM_ENABLED=false to freeze the demo positions.
GPS_SIM_ENABLED=true
GPS_SIM_INTERVAL_MS=15000

# Token for GET /api/metrics (Prometheus scrape). Empty = endpoint hidden (404).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
METRICS_TOKEN=

# Token for POST /api/gps/ingest (real GPS device webhook). Empty = endpoint hidden (404).
# Only enables LIVE telemetry when a registered ACTIVE GPS device sends data through it.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
GPS_INGEST_TOKEN=

# Optional telemetry freshness threshold (default 60s). OFFLINE threshold stays 2 minutes.
# GPS_STALE_AFTER_MS=60000

# External notification channels. In-app notifications always work and are never disabled.
# Leave disabled unless valid SMTP/Telegram credentials exist; then delivery history is
# recorded in the database (NotificationDelivery) with up to 3 attempts per message.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# NOTIFICATION_RETRY_BASE_MS=500

# Manual (non-Docker) backend development reads DATABASE_URL directly:
# DATABASE_URL=postgresql://fleet:fleet_demo_password@localhost:5544/fleet_demo?schema=public
