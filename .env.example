# Host ports used by docker compose (change if they are already in use)
DB_PORT=5544
API_PORT=4010
WEB_PORT=8090

# API security. Replace before sharing this environment with anyone.
JWT_SECRET=replace-this-demo-secret-before-deployment

# DEMO GPS simulator: generates simulated coordinates for the GPS Monitoring page.
# This is NOT a real GPS device integration. Set GPS_SIM_ENABLED=false to freeze the demo positions.
GPS_SIM_ENABLED=true
GPS_SIM_INTERVAL_MS=15000

# Manual (non-Docker) backend development reads DATABASE_URL directly:
# DATABASE_URL=postgresql://fleet:fleet_demo_password@localhost:5544/fleet_demo?schema=public
